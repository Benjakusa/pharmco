# ============================================================================
# PHARMCO — environment template (copy to .env, then run ./scripts/gen-env.sh
# or fill manually). NEVER commit .env. chmod 600 after generation.
# ============================================================================

# Public domain(s). api.<this> is used as the API endpoint.
BASE_DOMAIN=pharmco.co.ke

# --- PostgreSQL (master DB) ---
DB_PASS=

# --- API ---
JWT_SECRET=                 # HS256 signing key (>= 32 random bytes)
JWT_ADMIN_KEY=              # shared secret for /v1/admin/* (X-Admin-Key header)
DARAJA_ENC_KEY=             # AES-256-GCM key for daraja_config encryption (32 bytes)

# --- Auth tuning (POST /api/auth/login) ---
# JWT_ACCESS_TTL_MINUTES=15  # access token lifetime
# JWT_REFRESH_TTL_DAYS=30    # refresh token lifetime (stored hashed, rotating)
# RATE_LIMIT_MAX_ATTEMPTS=5  # failed logins per username before 429
# RATE_LIMIT_WINDOW_MINUTES=15

# --- Optional: daily encrypted backups (deploy/backup.sh) ---
# BACKUP_PASSPHRASE=        # if unset, backups are stored gzipped but NOT encrypted