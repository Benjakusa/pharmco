<Window x:Class="Pharmco.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Pharmco.Client.Views"
        Title="Pharmco POS" Width="1000" Height="620"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- License Banner -->
        <views:LicenseBanner x:Name="LicenseBannerView" Grid.Row="0"
                             Width="Auto" Height="Auto"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="PHARMCO POS"
                           FontSize="32" FontWeight="Bold"
                           Foreground="#1976D2"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Pharmacy Management System"
                           FontSize="14" Foreground="#666666"
                           Margin="0,8,0,24"
                           HorizontalAlignment="Center"/>
                <Button Content="Login" Width="120" Height="40"
                        Click="LoginButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Sync Status + Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FooterText" Grid.Column="0"
                       Text="Ready" FontSize="11" Foreground="#999999"
                       VerticalAlignment="Center"/>

            <views:SyncStatusIndicator x:Name="SyncIndicator" Grid.Column="1"
                                       Width="120" Height="24"/>
        </Grid>
    </Grid>
</Window>
