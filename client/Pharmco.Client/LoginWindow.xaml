<Window x:Class="Pharmco.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Pharmco POS"
        Width="360" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pharmco POS Login"
                   FontSize="20" FontWeight="SemiBold"
                   Margin="0,0,0,24"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Pharmacy Code" Margin="0,0,0,4"/>
            <TextBox x:Name="PharmacyCodeInput" Padding="8"
                     FontSize="14" Margin="0,0,0,12"/>

            <TextBlock Text="Username" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameInput" Padding="8"
                     FontSize="14" Margin="0,0,0,12"/>

            <TextBlock Text="Password" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordInput" Padding="8"
                         FontSize="14" Margin="0,0,0,12"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Login" Width="100"
                HorizontalAlignment="Right"
                Click="LoginButton_Click"
                IsDefault="True"/>
    </Grid>
</Window>
