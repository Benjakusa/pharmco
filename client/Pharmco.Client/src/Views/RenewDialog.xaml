<Window x:Class="Pharmco.Client.Views.RenewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renew License"
        Width="400" Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="License Renewal"
                   FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Pay the renewal fee via M-Pesa to continue using Pharmco POS."
                       TextWrapping="Wrap" Margin="0,0,0,16"
                       Foreground="#666666"/>

            <Border Background="#F5F5F5" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="M-Pesa Paybill" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="PaybillText" Text="500000" FontSize="16" Margin="0,0,0,12"
                               Foreground="#1976D2"/>

                    <TextBlock Text="Account Reference" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="AccountRefText" Text="PHARMCO-REHISTRY" FontSize="14" Margin="0,0,0,12"
                               Foreground="#333333"/>

                    <TextBlock Text="Amount (KES)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="AmountText" Text="KES 5,000" FontSize="16" Margin="0,0,0,12"
                               Foreground="#D32F2F"/>

                    <TextBlock Text="Pharmco Phone" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="PhoneText" Text="+254700000000" FontSize="14"
                               Foreground="#333333"/>
                </StackPanel>
            </Border>

            <TextBlock Text="After payment, enter your M-Pesa reference code below:"
                       Margin="0,0,0,8" Foreground="#666666"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="M-Pesa Ref:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="MpesaRefInput" Grid.Column="1"
                         Padding="8" FontSize="14"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button Content="Submit" Width="80" IsDefault="True"
                    Click="SubmitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
