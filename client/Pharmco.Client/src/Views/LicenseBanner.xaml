<UserControl x:Class="Pharmco.Client.Views.LicenseBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="400"
             Height="40">
    <Grid>
        <Border x:Name="BannerBorder" CornerRadius="4" Padding="12,8" Margin="0,0,0,8"
                Visibility="Collapsed">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF3E0"/>
                    <Setter Property="BorderBrush" Value="#FF9800"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tier}" Value="WarningYellow">
                            <Setter Property="Background" Value="#FFF3E0"/>
                            <Setter Property="BorderBrush" Value="#FF9800"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tier}" Value="WarningRed">
                            <Setter Property="Background" Value="#FFEBEE"/>
                            <Setter Property="BorderBrush" Value="#F44336"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tier}" Value="DailyModal">
                            <Setter Property="Background" Value="#FFEBEE"/>
                            <Setter Property="BorderBrush" Value="#F44336"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tier}" Value="GracePeriod">
                            <Setter Property="Background" Value="#FFF3E0"/>
                            <Setter Property="BorderBrush" Value="#FF9800"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tier}" Value="ReadOnly">
                            <Setter Property="Background" Value="#FFEBEE"/>
                            <Setter Property="BorderBrush" Value="#D32F2F"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tier}" Value="HardLock">
                            <Setter Property="Background" Value="#FFEBEE"/>
                            <Setter Property="BorderBrush" Value="#B71C1C"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WarningIcon" Text="⚠" FontSize="16" VerticalAlignment="Center"
                           Margin="0,0,8,0" Foreground="#FF9800"/>
                <TextBlock x:Name="WarningText" Grid.Column="1" Text="License warning"
                           VerticalAlignment="Center" Foreground="#333333" FontSize="13"
                           TextTrimming="CharacterEllipsis"/>
                <Button x:Name="RenewButton" Grid.Column="2" Content="Renew"
                        Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Center"
                        Click="RenewButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
