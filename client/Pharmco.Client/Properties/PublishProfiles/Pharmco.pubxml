<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishDir>bin\Release\Publish\</PublishDir>
    <PublishUrl>https://pharmco.co.ke/client/</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Web</InstallFrom>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <InstallUrl>https://pharmco.co.ke/client/</InstallUrl>
    <PublisherUrl>https://pharmco.co.ke/client/</PublisherUrl>
    <ProductName>Pharmco POS</ProductName>
    <PublisherName>Pharmco</PublisherName>
    <RegistryName>Pharmco POS</RegistryName>
    <CreateWebPageOnPublish>true</CreateWebPageOnPublish>
    <WebPage>index.html</WebPage>
    <EnableMsiSigning>false</EnableMsiSigning>
    <InstallVersion>1.0.$(BuildNumber)</InstallVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableUpdateAsync>true</EnableUpdateAsync>
  </PropertyGroup>
</Project>
